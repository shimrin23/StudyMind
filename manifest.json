{
  "manifest_version": 3,
  "name": "StudyMind",
  "version": "1.0.0",
  "description": "A distraction-free YouTube study environment.",
  "permissions": ["storage", "tabs"],
  "action": { "default_popup": "popup.html", "default_title": "StudyMind" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
